<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CECECA"
    tools:context=".NoteDetailsActivity">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CBD0C5"
        app:elevation="0dp">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:background="#E2E0E0">

            <ImageButton
                android:id="@+id/back_btn"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/arrow_back"
                android:scaleType="centerCrop"
                app:tint="@color/black"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/page_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Note"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/dm_serif_display"
                android:ellipsize="end"
                android:maxLines="1"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:id="@+id/edit_note_btn"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/edit"
                android:scaleType="centerCrop"
                app:tint="@color/accent"
                android:visibility="visible"
                android:contentDescription="Edit note" />

            <ImageButton
                android:id="@+id/save_note_btn"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_save_btn"
                android:src="@drawable/check"
                app:tint="@color/white"
                android:layout_marginStart="10dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:padding="8dp"
                android:contentDescription="Save note" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="120dp">

            <!-- Title card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="4dp">

                <!-- Title label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TITLE"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:letterSpacing="0.12"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp"
                    tools:ignore="HardcodedText" />

                <EditText
                    android:id="@+id/notes_title_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Note title..."
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:background="@null"
                    android:fontFamily="@font/dm_serif_display"
                    android:inputType="textCapSentences"
                    android:maxLines="3"
                    android:padding="0dp"
                    tools:text="My Note Title" />

            </LinearLayout>

            <!-- Timestamp row -->
            <LinearLayout
                android:id="@+id/timestamp_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/schedule"
                    app:tint="@color/text_hint"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/timestamp_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last edited today"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <!-- Thin divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="4dp"
                android:background="@color/divider" />

            <!-- Content section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <!-- Content label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTENT"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:letterSpacing="0.12"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp"
                    tools:ignore="HardcodedText" />

                <!-- Editable content -->
                <EditText
                    android:id="@+id/notes_content_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Write your note here..."
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:background="#EFEDE9"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="6"
                    android:gravity="top|start"
                    android:padding="5dp"
                    android:lineSpacingMultiplier="1.5"
                    tools:text="" />

                <!-- Read-only content -->
                <TextView
                    android:id="@+id/notes_content_readonly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:background="@null"
                    android:visibility="gone"
                    android:lineSpacingMultiplier="1.5"
                    android:padding="0dp"
                    tools:text="Read only content preview." />

            </LinearLayout>

            <!-- Attachments section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <!-- Section header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/attach_file"
                        app:tint="@color/text_secondary"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/attachments_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ATTACHMENTS"
                        android:textSize="11sp"
                        android:textColor="@color/text_hint"
                        android:letterSpacing="0.12"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

                <!-- Attachment items list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/attachments_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="16dp"
                    android:clipToPadding="false"
                    tools:itemCount="2"
                    tools:listitem="@layout/recycler_attachment_item" />

                <!-- Add attachment actions (edit mode only) -->
                <LinearLayout
                    android:id="@+id/attachment_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:gravity="start"
                    android:visibility="visible">

                    <!-- Add Image button -->
                    <LinearLayout
                        android:id="@+id/ll_AddImage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_chip"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp">

                        <ImageButton
                            android:id="@+id/add_image_btn"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@null"
                            android:src="@drawable/image"
                            android:scaleType="centerCrop"
                            android:contentDescription="Add image"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Upload"
                            android:textSize="13sp"
                            android:textColor="@color/accent"
                            android:fontFamily="sans-serif-medium"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>

                    <!-- Add URL button -->
                    <LinearLayout
                        android:id="@+id/ll_AddUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_chip"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp">

                        <ImageButton
                            android:id="@+id/add_url_btn"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@null"
                            android:src="@drawable/link"
                            android:scaleType="centerCrop"
                            android:contentDescription="Add URL"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="URL"
                            android:textSize="13sp"
                            android:textColor="@color/accent"
                            android:fontFamily="sans-serif-medium"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>

                    <!-- Add Page button -->
                    <LinearLayout
                        android:id="@+id/ll_AddPage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_chip"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp">

                        <ImageButton
                            android:id="@+id/add_page_btn"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@null"
                            android:src="@drawable/news"
                            android:scaleType="centerCrop"
                            android:contentDescription="Add page"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Page"
                            android:textSize="13sp"
                            android:textColor="@color/accent"
                            android:fontFamily="sans-serif-medium"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Delete button (existing notes only) -->
            <TextView
                android:id="@+id/delete_note_text_view_btn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Delete Note"
                android:textSize="14sp"
                android:textColor="@color/danger"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_delete_btn"
                android:visibility="gone"
                tools:ignore="HardcodedText"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>